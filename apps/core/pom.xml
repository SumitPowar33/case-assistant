<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
  </parent>
  <groupId>in.caseassistant</groupId>
  <artifactId>core</artifactId>
  <version>0.1.0</version>
  <properties>
    <java.version>21</java.version>
  </properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-oauth2-resource-server</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <!-- State packs and playbooks live at the repo root (shared with their Python checks); ship them on the classpath. -->
      <resource>
        <directory>../../packs</directory>
        <targetPath>packs</targetPath>
        <includes><include>*/playbooks/*.json</include><include>*/punishments.json</include><include>*/roles.json</include><include>*/policies.json</include><include>*/law-concordance.json</include><include>*/import-profiles/*.json</include><include>*/module.json</include><include>*/complaint-kinds.json</include><include>*/glossary.json</include><include>*/cdr-layouts.json</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
      <!-- Test coverage report (target/site/jacoco). Build-time only; ships nothing. -->
      <plugin>
        <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId><version>0.8.12</version>
        <executions>
          <execution><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>report</id><phase>test</phase><goals><goal>report</goal></goals></execution>
          <!-- Coverage may only go up: `mvn verify` fails below these. Raise them when the numbers rise. -->
          <execution>
            <id>gate</id><phase>verify</phase><goals><goal>check</goal></goals>
            <configuration><rules><rule><element>BUNDLE</element><limits>
              <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.96</minimum></limit>
              <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.93</minimum></limit>
            </limits></rule></rules></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- Mutation testing (TESTING.md, once a month): `mvn -P mutation test-compile org.pitest:pitest-maven:mutationCoverage`.
         Changes the rule code of the packs (punishment classes, policy bounds, roles, complaint kinds, playbooks, glossary,
         modules) one small step at a time and checks a unit test notices. Build-time only; not run by scripts/test-all.sh. -->
    <profile>
      <id>mutation</id>
      <build><plugins><plugin>
        <groupId>org.pitest</groupId><artifactId>pitest-maven</artifactId><version>1.17.0</version>
        <dependencies><dependency><groupId>org.pitest</groupId><artifactId>pitest-junit5-plugin</artifactId><version>1.2.1</version></dependency>
          <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-launcher</artifactId><version>1.12.2</version></dependency></dependencies>
        <configuration>
          <targetClasses><param>in.caseassistant.Punishments*</param><param>in.caseassistant.Policies*</param><param>in.caseassistant.Roles*</param>
            <param>in.caseassistant.ComplaintKinds*</param><param>in.caseassistant.Playbooks*</param><param>in.caseassistant.Glossary*</param><param>in.caseassistant.Modules*</param></targetClasses>
          <targetTests><param>in.caseassistant.PunishmentsTest</param><param>in.caseassistant.PoliciesTest</param><param>in.caseassistant.RolesTest</param>
            <param>in.caseassistant.ComplaintKindsTest</param><param>in.caseassistant.GlossaryTest</param><param>in.caseassistant.ModulesTest</param></targetTests>
          <timestampedReports>false</timestampedReports>
          <outputFormats><param>HTML</param><param>XML</param></outputFormats>
        </configuration>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
